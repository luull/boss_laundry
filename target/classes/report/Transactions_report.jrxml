	<dataset name="tableDataset" uuid="b61c32d5-2e01-478f-bc14-d528c5a3e1d1">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Bozz Laundry"/>
		<parameter name="id_cabang" class="java.lang.Integer"/>
		<parameter name="tgl_awal" class="java.sql.Date"/>
		<parameter name="tgl_akhir" class="java.sql.Date"/>
		<query language="SQL"><![CDATA[SELECT
    t.kode_invoice,
    p.nama_pelanggan,
    l.nama_layanan,
    t.berat,
    t.addons,
    t.total_harga,
    t.status,
    t.tanggal_masuk
FROM transaksi_laundry t
JOIN master_pelanggan p
ON t.id_pelanggan = p.id_pelanggan
JOIN master_layanan l
ON t.id_layanan = l.id_layanan
WHERE t.id_cabang = COALESCE($P{id_cabang}, t.id_cabang)
  AND t.tanggal_masuk >= COALESCE($P{tgl_awal}, t.tanggal_masuk)
  AND t.tanggal_masuk <= COALESCE($P{tgl_akhir}, t.tanggal_masuk)
ORDER BY t.tanggal_masuk DESC, t.id_transaksi DESC]]></query>
