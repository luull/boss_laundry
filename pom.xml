<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycompany</groupId>
    <artifactId>BozzLaundry</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>com.mycompany.bozzlaundry.BozzLaundry</exec.mainClass>
    </properties>

    <dependencies>

        <!-- Driver JDBC PostgreSQL untuk koneksi ke Supabase.
             Kompatibel dengan Java 8+ (termasuk target Java 17 proyek ini).
             42.7.14 adalah rilis dengan perbaikan keamanan terbaru. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>
        <dependency>
             <groupId>net.sf.jasperreports</groupId>
             <artifactId>jasperreports</artifactId>
             <version>7.0.6</version>
         </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-pdf</artifactId>
            <version>7.0.6</version>
        </dependency>
        <dependency>
            <groupId>com.lowagie</groupId>
            <artifactId>itext</artifactId>
            <version>2.1.7</version>
        </dependency>

    </dependencies>
<build>

    <plugins>

        <plugin>

            <groupId>
                org.apache.maven.plugins
            </groupId>

            <artifactId>
                maven-compiler-plugin
            </artifactId>

            <version>3.11.0</version>

            <configuration>

                <release>17</release>

            </configuration>

        </plugin>

        <plugin>

            <groupId>
                org.apache.maven.plugins
            </groupId>

            <artifactId>
                maven-shade-plugin
            </artifactId>

            <version>3.5.0</version>

            <executions>

                <execution>

                    <phase>package</phase>

                    <goals>
                        <goal>shade</goal>
                    </goals>

                    <configuration>

                        <transformers>

                            <transformer
                                implementation=
                                "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">

                                <mainClass>
                                    com.mycompany.bozzlaundry.BozzLaundry
                                </mainClass>

                            </transformer>

                        </transformers>

                    </configuration>

                </execution>

            </executions>

        </plugin>

    </plugins>

</build>

</project>